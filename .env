# Runtime environment name used by the config loader. "local" is fine for local runs.
EXECUTION_ENV=local

# Base URL for the web application. Required for browser tests.
BASE_URL=https://demo.firefly-iii.org

# Base URL for the API under test. Firefly III uses the /api prefix.
API_URL=https://demo.firefly-iii.org/api

# Active region used for region-specific test data generation and config selection.
REGION=eu

# Optional path prefixes if the app or API is hosted under a subpath.
WEB_PATH_PREFIX=/
API_PATH_PREFIX=/

# API authentication mode. "none" is suitable for public/demo APIs.
API_AUTH_MODE=none

# Only required when API_AUTH_MODE is set to a token-based mode.
API_AUTH_TOKEN=
API_CLIENT_ID=
API_CLIENT_SECRET=

# Optional credentials for web login flows. Leave blank if the app does not require auth.
WEB_USERNAME=demo@firefly-iii.org
WEB_PASSWORD=demo

# Optional payment request values used by API contract tests.
PAYMENT_SOURCE_ACCOUNT_ID=demo-source
PAYMENT_DESTINATION_ACCOUNT_ID=demo-destination
PAYMENT_AMOUNT=25
PAYMENT_CURRENCY=EUR
PAYMENT_IDEMPOTENCY_KEY_PREFIX=payment

# Run browser tests headlessly by default.
HEADLESS=true

# Worker count for local runs. Can be a number or a percentage string.
WORKERS=50%

# Lower worker count for CI to reduce resource pressure.
CI_WORKERS=2

# Number of retries for flaky tests.
RETRIES=1

# Timeouts in milliseconds.
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000

# Playwright reporting and artifact capture behavior.
TRACE_MODE=on-first-retry
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure

