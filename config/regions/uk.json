{
  "code": "uk",
  "locale": "en-GB",
  "currency": "GBP",
  "timeZone": "Europe/London",
  "api": {
    "pathPrefix": "/",
    "defaultHeaders": {
      "x-region": "uk"
    },
    "auth": {
      "strategy": "client-credentials",
      "clientIdEnvKey": "UK_API_CLIENT_ID",
      "clientSecretEnvKey": "UK_API_CLIENT_SECRET",
      "scope": "accounts.read accounts.write payments.write"
    }
  },
  "web": {
    "pathPrefix": "/"
  },
  "users": {
    "retailUsernameEnvKey": "UK_WEB_USERNAME",
    "retailPasswordEnvKey": "UK_WEB_PASSWORD"
  }
}
