{
  "code": "eu",
  "locale": "en-IE",
  "currency": "EUR",
  "timeZone": "Europe/Dublin",
  "api": {
    "pathPrefix": "/",
    "defaultHeaders": {
      "x-region": "eu"
    },
    "auth": {
      "strategy": "client-credentials",
      "clientIdEnvKey": "EU_API_CLIENT_ID",
      "clientSecretEnvKey": "EU_API_CLIENT_SECRET",
      "scope": "accounts.read accounts.write payments.write"
    }
  },
  "web": {
    "pathPrefix": "/"
  },
  "users": {
    "retailUsernameEnvKey": "EU_WEB_USERNAME",
    "retailPasswordEnvKey": "EU_WEB_PASSWORD"
  }
}
